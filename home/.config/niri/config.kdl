// ~/.config/niri/config.kdl — glasstty.
//
//  * The shell's shortcuts are `qs ipc call <target> <function>`, served by the
//    IpcHandlers in TopShell.qml ("notch"), WallpaperPicker.qml ("wallpaper")
//    and MediaControls.qml ("media").
//  * Super+J cycles column widths; Super+Shift+Tab is niri's own Overview.
//  * Night light is wlsunset (glasstty/scripts/night-light.sh); the portal is
//    xdg-desktop-portal-gnome (niri's default).
//
// Two optional includes at the end carry what the shell writes at runtime:
//   ~/.cache/wal/colors-niri.kdl   border colours from pywal (wal template)
//   ~/.config/niri/efeitos.kdl     window rounding from Settings > Appearance

input {
    keyboard {
        xkb {
            layout "br"
        }
        numlock
    }
    touchpad {
        tap
        // GNOME here has natural scroll off; hyprland.lua had it on.
        // Flip this line if you want the Hyprland feel.
        // natural-scroll
    }
    // Hyprland's follow_mouse = 1.
    focus-follows-mouse max-scroll-amount="0%"
}

// Monitors are placed at runtime by the shell (Settings > Displays ->
// scripts/monitors.py -> `niri msg output ...`). Static rules can go here:
// output "eDP-1" { scale 1.0; }

layout {
    // Law 8 of the rice: one gap everywhere. Hyprland had 3 in + 6 out, which
    // is 6 px between windows and 6 to the edge; niri's `gaps` is both.
    gaps 6
    center-focused-column "never"
    background-color "transparent"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    default-column-width { proportion 0.5; }

    // Focus is marked with light, not with an outline (Law 2): no focus ring.
    focus-ring {
        off
    }
    // The border carries the pywal palette (gradient color4 -> color6, like
    // Hyprland's active_border). Colours are overridden by colors-niri.kdl.
    border {
        width 1
        active-gradient from="#394aad" to="#a15bc8" angle=45
        inactive-color "#648a91"
    }
    shadow {
        on
        softness 28
        spread 4
        offset x=0 y=6
        color "#000000ee"
        inactive-color "#00000000"   // hyprland.lua: shadow only on the focused window
    }
}

prefer-no-csd

// The notch reserves its band with an exclusive zone, so no struts here.

hotkey-overlay {
    skip-at-startup
}

// niri's own screenshot action only; the binds use the scripts, which ask
// xdg-user-dir. On this pt_BR system the pictures folder is ~/Imagens.
screenshot-path "~/Imagens/screenshots/%Y-%m-%d_%H-%M-%S.png"

environment {
    // Qt follows the GTK/GNOME theme (icons Tela-black-dark, dark palette) via
    // Qt's own gtk3 platform theme: qt6ct is not installed on this Fedora.
    QT_QPA_PLATFORMTHEME "gtk3"
    // Apps in the wallpaper's colours: gtk-pywal.sh regenerates this theme at
    // every wallpaper change and keeps ~/.local/share/themes/pywal-gtk pointing
    // at it. Set only for this session; GNOME keeps Orchis via dconf. New
    // windows get the new colours (open ones keep theirs). Comment this line
    // to use GNOME's theme (Orchis-Dark-Compact) here too.
    GTK_THEME "pywal-gtk"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

// niri's X11 support goes through xwayland-satellite (installed).
xwayland-satellite {
    path "xwayland-satellite"
}

// ─────────────────────────── autostart ───────────────────────────
// Everything here runs ONLY in the niri session. Nothing is enabled as a
// systemd --user unit WantedBy=graphical-session.target, because GNOME
// reaches that target too and would start a second bar on top of its own.
// Apps started by D-Bus activation (Nautilus when another app opens a folder)
// do not inherit niri's `environment {}`: publish the theme variables to the
// session's activation environment too. niri.service.d/theme-env.conf unsets
// them when niri exits, so a later GNOME login never sees them.
spawn-sh-at-startup "dbus-update-activation-environment --systemd GTK_THEME=pywal-gtk QT_QPA_PLATFORMTHEME=gtk3 ${DCONF_PROFILE:+DCONF_PROFILE=$DCONF_PROFILE}"
spawn-sh-at-startup "qs --no-duplicate"
spawn-sh-at-startup "~/.config/glasstty/awww-start.sh"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-sh-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
spawn-sh-at-startup "python3 ~/.config/quickshell/scripts/bt-agent.py"
// Idle: lock after 5 min, screen off after 10, lock before sleep.
// The lock is the shell's (thyx look); lock.sh falls back to swaylock.
// `lock` also answers `loginctl lock-session`.
spawn-sh-at-startup "swayidle -w timeout 300 '~/.config/quickshell/scripts/lock.sh' timeout 600 'niri msg action power-off-monitors' before-sleep '~/.config/quickshell/scripts/lock.sh' lock '~/.config/quickshell/scripts/lock.sh'"

// ─────────────────────────── window rules ───────────────────────────
// Settings from the notch: floating, centred, 900x620.
window-rule {
    match app-id="^org\\.quickshell$" title="^Ajustes$"
    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 620; }
}

window-rule {
    match app-id="^imv$"
    open-floating true
    default-column-width { proportion 0.7; }
    default-window-height { proportion 0.7; }
}

// The terminal is translucent (kitty background_opacity 0.85): niri blurs what
// is behind it, so it reads as frosted glass instead of text over a busy image.
// Borders only as an outline. With prefer-no-csd niri fills the border/focus
// ring as a rectangle BEHIND each window; through a translucent window (kitty)
// that showed as the whole terminal tinted with the active border colour.
window-rule {
    draw-border-with-background false
    // Frosted glass behind every window. Only visible where the app paints a
    // translucent background (the pywal GTK theme does, see gtk-pywal.sh);
    // opaque apps (browsers) are unaffected. xray: blurs the wallpaper once
    // and reuses it, so it costs almost nothing per window.
    background-effect {
        blur true
        xray true
    }
}

window-rule {
    match app-id="^kitty$"
    background-effect {
        blur true
        xray false
    }
}

// Every window is slightly see-through, focused or not (this fork). Most apps
// (browsers, Electron like VS Code and Spotify) paint an opaque window, so niri
// fades the whole window, text included, and the blur rule above frosts what
// is behind it so it stays readable. Apps that already have a translucent
// BACKGROUND with opaque text are left at full opacity, or they would fade
// twice: kitty (background_opacity) and the GNOME apps on the pywal theme.
window-rule {
    opacity 0.88
}

window-rule {
    match app-id="^org\\.gnome\\."
    match app-id="^org\\.quickshell$"
    opacity 1.0
}

window-rule {
    match app-id="^com\\.microsoft\\.VSCode$"
    match app-id="^code$"
    background-effect {
        blur true
        xray false
    }
}

// Hyprland's dim_inactive: unfocused windows a step more transparent.
window-rule {
    match is-active=false
    opacity 0.82
}

// Games: fully opaque, focused or not, no blur behind them, and opened
// fullscreen, over the bar. Steam games
// (native or Proton) show up as steam_app_<id>; gamescope wraps others.
// After the inactive rule so it wins there too.
window-rule {
    match app-id="^steam_app_"
    match app-id="^gamescope$"
    opacity 1.0
    open-fullscreen true
    background-effect {
        blur false
    }
}

// The terminal: one transparency whether focused or not. It comes after the
// inactive rule so it wins there too; kitty's own background_opacity is under it.
window-rule {
    match app-id="^kitty$"
    opacity 0.87
}

// Wallpaper surfaces stay put under the Overview (it zooms the workspaces).
layer-rule {
    match namespace="^awww-daemon$"
    match namespace="^swaybg$"
    match namespace="^quickshell:wallfx$"
    place-within-backdrop true
}

// Glass bar: the shell asks niri (ext-background-effect) to blur behind the
// band and the notch. Real blur, not xray: the notch opens into panels that sit
// over windows, and xray would show the wallpaper there instead of the windows.
layer-rule {
    match namespace="^quickshell:bar$"
    // Only `xray false` here. Saturation/noise in this rule apply to the WHOLE
    // bar surface (full width, 586 px tall so the Control Centre fits) whenever
    // the shell is not requesting blur (empty workspace): the top half of the
    // screen came out more saturated than the bottom, a visible line at 586 px.
    background-effect {
        xray false
    }
}

// The overview's own backdrop follows the wallpaper rather than flat grey.
overview {
    zoom 0.5
    workspace-shadow {
        off
    }
}

// ─────────────────────────── binds ───────────────────────────
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // ── the shell (Hyprland: hl.dsp.global("quickshell:…")) ──
    Mod+D            hotkey-overlay-title="Central de controle" { spawn "qs" "ipc" "call" "notch" "control"; }
    Ctrl+Space       hotkey-overlay-title="Launcher" { spawn "qs" "ipc" "call" "notch" "launcher"; }
    Mod+Comma        hotkey-overlay-title="Ajustes" { spawn "qs" "ipc" "call" "notch" "settings"; }
    Mod+A            { spawn "qs" "ipc" "call" "notch" "settings"; }
    Mod+Tab          hotkey-overlay-title="Mapa de áreas de trabalho" { spawn "qs" "ipc" "call" "notch" "overview"; }
    // Stage Manager = niri's Overview (no IPC round trip needed).
    Mod+Shift+Tab    hotkey-overlay-title="Overview (Stage Manager)" { toggle-overview; }
    Mod+Shift+D      { spawn "qs" "ipc" "call" "notch" "system"; }
    Mod+Shift+E      { spawn "qs" "ipc" "call" "notch" "power"; }
    Mod+K            { spawn "qs" "ipc" "call" "notch" "keys"; }
    Mod+W            hotkey-overlay-title="Wallpapers" { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    Mod+B            hotkey-overlay-title="Esconder/mostrar barra" { spawn "qs" "ipc" "call" "notch" "bar"; }
    Mod+N            { spawn "qs" "ipc" "call" "notch" "style"; }
    Mod+Shift+V      { spawn "qs" "ipc" "call" "notch" "clipboard"; }
    Mod+Alt+Space    { spawn "qs" "ipc" "call" "notch" "actions"; }
    Mod+Shift+M      { spawn "qs" "ipc" "call" "media" "toggle"; }
    Mod+Shift+W      { spawn "qs" "ipc" "call" "wallpaper" "toggle"; }
    Mod+G            { spawn-sh "~/.config/quickshell/reload.sh"; }
    XF86PowerOff     { spawn "qs" "ipc" "call" "notch" "power"; }

    // ── apps ──
    Mod+T            hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+E            hotkey-overlay-title="Arquivos" { spawn "nautilus" "--new-window"; }

    // ── windows ──
    Mod+C            repeat=false { close-window; }
    Alt+F4           repeat=false hotkey-overlay-title="Fechar janela" { close-window; }
    Mod+V            { toggle-window-floating; }
    // Super+F: maximised to the screen's edges (no gaps; the bar stays).
    // The old column-wide maximise (keeps the 6 px gaps) is Super+Ctrl+F.
    Mod+F            hotkey-overlay-title="Maximizar até as bordas" { maximize-window-to-edges; }
    Mod+Ctrl+F       hotkey-overlay-title="Maximizar coluna (com espaçamento)" { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+J            { switch-preset-column-width; }
    // Arrows: Super+arrows move the FOCUS, Super+Shift+arrows move the WINDOW
    // (swapped with niri's default, where that is Super+Ctrl), and
    // Super+Ctrl+arrows change monitor.
    Mod+Left         { focus-column-left; }
    Mod+Right        { focus-column-right; }
    Mod+Up           { focus-window-up; }
    Mod+Down         { focus-window-down; }
    Mod+Shift+Left   hotkey-overlay-title="Mover janela para a esquerda" { move-column-left; }
    Mod+Shift+Right  hotkey-overlay-title="Mover janela para a direita" { move-column-right; }
    Mod+Shift+Up     { move-window-up; }
    Mod+Shift+Down   { move-window-down; }
    Mod+Ctrl+Left    { focus-monitor-left; }
    Mod+Ctrl+Right   { focus-monitor-right; }
    Mod+Ctrl+Up      { focus-monitor-up; }
    Mod+Ctrl+Down    { focus-monitor-down; }
    Mod+Page_Down    { focus-workspace-down; }
    Mod+Page_Up      { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    // The same with arrows: the brackets are awkward on the ABNT2 keyboard.
    // Pulls the window into the neighbouring column (stacked, sharing the
    // height) or, if it is already stacked, takes it out into its own column.
    Mod+Alt+Left     hotkey-overlay-title="Empilhar/separar janela (esquerda)" { consume-or-expel-window-left; }
    Mod+Alt+Right    hotkey-overlay-title="Empilhar/separar janela (direita)" { consume-or-expel-window-right; }

    // ── workspaces: Super+1..0, Super+Shift+1..0 sends the window ──
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // ── session ──
    Mod+L            hotkey-overlay-title="Bloquear" { spawn-sh "~/.config/quickshell/scripts/lock.sh"; }
    Mod+M            { quit; }
    Mod+Shift+P      { power-off-monitors; }

    // ── screenshots / tools ──
    Mod+Shift+S      { spawn-sh "~/.config/glasstty/scripts/screenshot-region.sh"; }
    Print            { spawn-sh "~/.config/glasstty/scripts/screenshot-full.sh"; }
    Mod+Ctrl+S       { spawn-sh "~/.config/glasstty/scripts/screenshot-annotate.sh"; }
    Mod+Shift+C      { spawn-sh "~/.config/glasstty/scripts/colorpicker.sh"; }
    Mod+Shift+N      { spawn-sh "~/.config/glasstty/scripts/night-light.sh"; }
    Mod+Ctrl+T       { spawn-sh "~/.config/glasstty/scripts/ocr.sh"; }
    Mod+Ctrl+R       { spawn-sh "~/.config/glasstty/scripts/screenrecord.sh"; }
    Mod+Ctrl+Shift+R { spawn-sh "~/.config/glasstty/scripts/screenrecord.sh --sonido"; }

    // ── media keys (work on the lock screen too) ──
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume -l 1.4 @DEFAULT_AUDIO_SINK@ 2%+"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "qs" "ipc" "call" "notch" "bright" "up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "qs" "ipc" "call" "notch" "bright" "down"; }
    XF86AudioNext         allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPause        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPlay         allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev         allow-when-locked=true { spawn "playerctl" "previous"; }
}

// Runtime-written pieces (see the header). Optional: missing on first boot.
include optional=true "~/.cache/wal/colors-niri.kdl"
include optional=true "efeitos.kdl"
