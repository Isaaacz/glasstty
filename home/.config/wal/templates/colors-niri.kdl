// pywal -> ~/.cache/wal/colors-niri.kdl (wallpaper colours for niri)
// Twin of colors-hyprland.lua. Included by ~/.config/niri/config.kdl;
// niri watches includes and recolours live when pywal rewrites this.
layout {{
    // Subtle on purpose: 1 px (config.kdl) and translucent, so the focused
    // window is told apart by a soft line, not an alarm. Alpha is the last
    // two hex digits (aa = 67 %, 55 = 33 %, 33 = 20 %).
    border {{
        active-gradient from="{color4}aa" to="{color6}55" angle=45
        inactive-color "{color8}33"
    }}
    shadow {{
        color "{background}ee"
    }}
}}
overview {{
    backdrop-color "{background}"
}}
