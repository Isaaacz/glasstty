// fastfetch, compact: the greeting a new kitty window opens with
// (glasstty/shell/glasstty.bash). A small logo and the few lines worth a
// glance; `fastfetch` alone still prints the full config.jsonc.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue" }
    },
    "modules": [
        "break",
        { "type": "os", "key": "󰣛 " },
        { "type": "kernel", "key": " " },
        { "type": "uptime", "key": "󰔟 " },
        { "type": "packages", "key": "󰏖 " },
        { "type": "memory", "key": "󰍛 " },
        { "type": "battery", "key": "󰁹 " },
        "break",
        { "type": "colors", "symbol": "circle" }
    ]
}
